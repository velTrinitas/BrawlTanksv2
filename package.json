{
  "name": "brawl-tanks-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:test": "tsc && vite build && node tools/pack-test.mjs",
    "preview": "vite preview",
    "sigma": "node tools/sigma-tester/run.mjs",
    "sigma:smoke": "node tools/sigma-tester/run.mjs --matrix smoke",
    "sigma:report": "node tools/sigma-tester/report.mjs",
    "analysis": "node tools/analysis/analyze.mjs && node tools/analysis/render.mjs && node tools/analysis/make-pdf.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@types/howler": "^2.2.13",
    "howler": "^2.2.4",
    "pixi.js": "^7.4.3"
  }
}
